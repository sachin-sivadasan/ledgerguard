{
  "info": {
    "name": "LedgerGuard API",
    "description": "Revenue Intelligence Platform for Shopify App Developers.\n\nSetup:\n1. Run '01 - Firebase Sign In' to get a token\n2. Token is auto-saved to {{firebaseToken}} variable\n3. All other requests use it automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "firebaseApiKey",
      "value": "AIzaSyAS0eqroCDyj7E87tUCVnUgwhXTNV9zv-g"
    },
    {
      "key": "firebaseToken",
      "value": ""
    },
    {
      "key": "appID",
      "value": "4599915"
    },
    {
      "key": "appUUID",
      "value": "",
      "description": "Internal UUID from sync_jobs/apps table \u2014 set after Select App"
    },
    {
      "key": "subscriptionID",
      "value": ""
    },
    {
      "key": "jobID",
      "value": ""
    },
    {
      "key": "domain",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Auth",
      "item": [
        {
          "name": "01 - Firebase Sign In (Get Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.idToken) {",
                  "    pm.collectionVariables.set('firebaseToken', json.idToken);",
                  "    console.log('Token saved! Expires in ' + json.expiresIn + 's');",
                  "}",
                  "pm.test('Sign in successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(json.idToken).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"your-email@example.com\",\n    \"password\": \"your-password\",\n    \"returnSecureToken\": true\n}"
            },
            "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}"
          }
        },
        {
          "name": "02 - Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/me"
          }
        }
      ]
    },
    {
      "name": "01 - Apps",
      "item": [
        {
          "name": "List Apps",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/apps"
          }
        },
        {
          "name": "Get Available Apps (from Shopify)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/apps/available"
          }
        },
        {
          "name": "Select App",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.uuid) { pm.collectionVariables.set('appUUID', json.uuid); }",
                  "    if (json.id) { pm.collectionVariables.set('appID', json.id); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"partner_app_id\": \"gid://partners/App/12345\",\n    \"name\": \"My App\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/apps/select"
          }
        },
        {
          "name": "Update App Tier",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tier\": \"DEFAULT_20\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/apps/{{appID}}/tier"
          }
        },
        {
          "name": "Update Store Slug",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"slug\": \"my-app-slug\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/apps/{{appID}}/store-slug"
          }
        },
        {
          "name": "Get Install Count",
          "request": {
            "method": "GET",
            "header": [
