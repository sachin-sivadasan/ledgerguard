# LedgerGuard production environment (Hetzner)
# Copy to repo-root .env and fill in real values:  cp deploy/.env.example .env
# NEVER commit the real .env. Generate secrets with: openssl rand -hex 16 / -base64 24

# --- Postgres (self-hosted container) ---
DB_USER=ledgerguard
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=ledgerguard

# --- Redis (self-hosted container) ---
REDIS_PASSWORD=CHANGE_ME_strong_password

# --- Server ---
INTERNAL_KEY=CHANGE_ME_internal_admin_key

# --- Encryption ---
# REUSE the existing 32-hex-char master key from the old deployment so
# already-encrypted data (e.g. Shopify tokens) stays decryptable.
# Only generate a new one for a fresh DB with no encrypted data: openssl rand -hex 16
ENCRYPTION_MASTER_KEY=REUSE_EXISTING_32_HEX_CHAR_KEY

# --- Shopify Partner API (from Partner Dashboard) ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://api.ledgerspear.com/api/v1/integrations/shopify/callback
SHOPIFY_SCOPES=read_analytics
# Leave blank for real Shopify; set to a mock URL only for testing
SHOPIFY_PARTNER_API_URL=

# --- OpenAI (AI chat) ---
# ROTATE this key during migration (the old one was surfaced in plaintext)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Razorpay (billing) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=

# --- Queue / sync pipeline ---
QUEUE_ENABLED=true
QUEUE_NUM_WORKERS=3
QUEUE_FULL_SYNC_WORKERS=1
