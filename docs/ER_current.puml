@startuml ER_LedgerGuard_Current
!theme plain
skinparam linetype ortho

title LedgerGuard - Entity Relationship Diagram (Current Implementation)

entity "users" as users {
  *id : UUID <<PK>>
  --
  *firebase_uid : VARCHAR(128) <<UNIQUE>>
  *email : VARCHAR(255)
  *role : VARCHAR(20) <<CHECK: OWNER, ADMIN>>
  plan_tier : VARCHAR(20) <<DEFAULT: FREE>>
  onboarding_completed_at : TIMESTAMPTZ
  created_at : TIMESTAMPTZ
}

entity "partner_accounts" as partner_accounts {
  *id : UUID <<PK>>
  --
  *user_id : UUID <<FK>>
  org_id : UUID <<FK>>
  *integration_type : VARCHAR(20) <<CHECK: OAUTH, MANUAL>>
  *partner_id : VARCHAR(100)
  *encrypted_access_token : BYTEA
  created_at : TIMESTAMPTZ
}

entity "apps" as apps {
  *id : UUID <<PK>>
  --
  *partner_account_id : UUID <<FK>>
  *partner_app_id : VARCHAR(100)
  *name : VARCHAR(255)
  tracking_enabled : BOOLEAN <<DEFAULT: TRUE>>
  revenue_share_tier : VARCHAR(20) <<DEFAULT: SMALL_DEV_0>>
  install_count : INT <<DEFAULT: 0>>
  app_store_slug : VARCHAR(255)
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
  <<UNIQUE: partner_account_id, partner_app_id>>
}

entity "transactions" as transactions {
  *id : UUID <<PK>>
  --
  *app_id : UUID <<FK>>
  *shopify_gid : VARCHAR(255) <<UNIQUE>>
  *myshopify_domain : VARCHAR(255)
  shop_name : VARCHAR(255)
  *charge_type : VARCHAR(20) <<CHECK: RECURRING, USAGE, ONE_TIME, REFUND>>
  gross_amount_cents : BIGINT
  shopify_fee_cents : BIGINT
  processing_fee_cents : BIGINT
  tax_on_fees_cents : BIGINT
  net_amount_cents : BIGINT
  *amount_cents : BIGINT
  currency : VARCHAR(3) <<DEFAULT: USD>>
  *transaction_date : TIMESTAMPTZ
  created_date : TIMESTAMPTZ
  available_date : TIMESTAMPTZ
  earnings_status : VARCHAR(20) <<DEFAULT: PENDING>>
  --
  ' Shop details (migration 000020)
  shopify_shop_gid : VARCHAR(255)
  shop_plan : VARCHAR(100)
  --
  ' Subscription reference (migration 000020)
  subscription_gid : VARCHAR(255)
  subscription_status : VARCHAR(50)
  subscription_period_end : TIMESTAMPTZ
  billing_interval : VARCHAR(20)
  --
  created_at : TIMESTAMPTZ
}

entity "subscriptions" as subscriptions {
  *id : UUID <<PK>>
  --
  *app_id : UUID <<FK>>
  *shopify_gid : VARCHAR(255) <<UNIQUE>>
  shopify_shop_gid : VARCHAR(255)
  stable_domain_key : VARCHAR(50)
  *myshopify_domain : VARCHAR(255)
  shop_name : VARCHAR(255)
  plan_name : VARCHAR(255)
  *base_price_cents : BIGINT
  currency : VARCHAR(3) <<DEFAULT: USD>>
  billing_interval : VARCHAR(20) <<CHECK: MONTHLY, ANNUAL>>
  *status : VARCHAR(20) <<CHECK: ACTIVE, CANCELLED, FROZEN, PENDING, UNINSTALLED>>
  last_recurring_charge_date : TIMESTAMPTZ
  expected_next_charge_date : TIMESTAMPTZ
  *risk_state : VARCHAR(30) <<CHECK: SAFE, ONE_CYCLE_MISSED, TWO_CYCLES_MISSED, CHURNED>>
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
  deleted_at : TIMESTAMPTZ <<SOFT DELETE>>
}

entity "subscription_events" as subscription_events {
  *id : UUID <<PK>>
  --
  *subscription_id : UUID <<FK>>
  *from_status : VARCHAR(50)
  *to_status : VARCHAR(50)
  *from_risk_state : VARCHAR(50)
  *to_risk_state : VARCHAR(50)
  *event_type : VARCHAR(50) <<CHECK: webhook, sync, manual, billing_failure, app_uninstalled>>
  reason : TEXT
  *occurred_at : TIMESTAMPTZ
  created_at : TIMESTAMPTZ
}

entity "daily_metrics_snapshot" as daily_metrics_snapshot {
  *id : UUID <<PK>>
  --
  *app_id : UUID <<FK>>
  *date : DATE
  active_mrr_cents : BIGINT
  revenue_at_risk_cents : BIGINT
  usage_revenue_cents : BIGINT
  total_revenue_cents : BIGINT
  renewal_success_rate : DECIMAL(5,4)
  safe_count : INT
  one_cycle_missed_count : INT
  two_cycles_missed_count : INT
  churned_count : INT
  total_subscriptions : INT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
  <<UNIQUE: app_id, date>>
}

entity "daily_insight" as daily_insight {
  *id : UUID <<PK>>
  --
  *app_id : UUID <<FK>>
  *date : DATE
  *insight_text : TEXT
  created_at : TIMESTAMPTZ
  <<UNIQUE: app_id, date>>
}

entity "device_tokens" as device_tokens {
  *id : UUID <<PK>>
  --
  *user_id : UUID <<FK>>
  *device_token : TEXT <<UNIQUE>>
  *platform : VARCHAR(20) <<CHECK: ios, android, web>>
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "notification_preferences" as notification_preferences {
  *id : UUID <<PK>>
  --
  *user_id : UUID <<FK, UNIQUE>>
  critical_enabled : BOOLEAN <<DEFAULT: TRUE>>
  daily_summary_enabled : BOOLEAN <<DEFAULT: TRUE>>
  daily_summary_time : TIME <<DEFAULT: 08:00>>
  slack_webhook_url : TEXT
  email_enabled : BOOLEAN <<DEFAULT: TRUE>>
  slack_enabled : BOOLEAN <<DEFAULT: FALSE>>
  churn_alerts_enabled : BOOLEAN <<DEFAULT: TRUE>>
  revenue_alerts_enabled : BOOLEAN <<DEFAULT: TRUE>>
  review_alerts_enabled : BOOLEAN <<DEFAULT: TRUE>>
  risk_threshold_days : INTEGER <<DEFAULT: 30>>
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "user_preferences" as user_preferences {
  *id : UUID <<PK>>
  --
  *user_id : UUID <<FK, UNIQUE>>
  default_app_id : UUID <<FK>>
  selected_org_id : UUID <<FK>>
  auto_sync : BOOLEAN <<DEFAULT: TRUE>>
  sync_frequency : VARCHAR(20) <<DEFAULT: Every 6 hours>>
  workspace_name : VARCHAR(100) <<DEFAULT: My Shopify Apps>>
  currency : VARCHAR(3) <<DEFAULT: USD>>
  timezone : VARCHAR(50) <<DEFAULT: America/New_York>>
  primary_kpis : TEXT[]
  secondary_widgets : TEXT[]
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "organizations" as organizations {
  *id : UUID <<PK>>
  --
  *name : VARCHAR(255)
  slug : VARCHAR(100) <<UNIQUE>>
  *plan_tier : VARCHAR(20) <<CHECK: FREE, STARTER, PRO>>
  webhook_url : TEXT
  webhook_secret : VARCHAR(64)
  sso_provider : VARCHAR(50) <<CHECK: SAML, OIDC>>
  sso_config : JSONB
  *created_by : UUID <<FK>>
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "org_members" as org_members {
  *id : UUID <<PK>>
  --
  *org_id : UUID <<FK>>
  *user_id : UUID <<FK>>
  *role : VARCHAR(20) <<CHECK: OWNER, ADMIN, VIEWER>>
  *status : VARCHAR(20) <<CHECK: ACTIVE, SUSPENDED>>
  notification_prefs : JSONB
  invited_by : UUID <<FK>>
  suspended_by : UUID <<FK>>
  suspended_at : TIMESTAMPTZ
  joined_at : TIMESTAMPTZ
  <<UNIQUE: org_id, user_id>>
}

entity "org_invitations" as org_invitations {
  *id : UUID <<PK>>
  --
  *org_id : UUID <<FK>>
  *email : VARCHAR(255)
  *role : VARCHAR(20) <<CHECK: ADMIN, VIEWER>>
  *invited_by : UUID <<FK>>
  *token : VARCHAR(64) <<UNIQUE>>
  *status : VARCHAR(20) <<CHECK: PENDING, ACCEPTED, EXPIRED, REVOKED>>
  *expires_at : TIMESTAMPTZ
  created_at : TIMESTAMPTZ
  <<UNIQUE: org_id, email, status>>
}

entity "org_audit_log" as org_audit_log {
  *id : UUID <<PK>>
  --
  *org_id : UUID <<FK>>
  *actor_id : UUID <<FK>>
  *action : VARCHAR(50)
  target_type : VARCHAR(30)
  target_id : UUID
  metadata : JSONB
  ip_address : INET
  created_at : TIMESTAMPTZ
}

entity "api_keys" as api_keys {
  *id : UUID <<PK>>
  --
  *user_id : UUID <<FK>>
  org_id : UUID <<FK>>
  name : VARCHAR(100)
  *key_hash : VARCHAR(64) <<UNIQUE>>
  rate_limit_per_minute : INT <<DEFAULT: 60>>
  created_at : TIMESTAMPTZ
  revoked_at : TIMESTAMPTZ
  ' Active status determined by: revoked_at IS NULL
}

entity "api_audit_log" as api_audit_log {
  *id : UUID <<PK>>
  --
  *api_key_id : UUID <<FK>>
  *endpoint : VARCHAR(255)
  *method : VARCHAR(10)
  request_params : JSONB
  *response_status : INT
  *response_time_ms : INT
  ip_address : VARCHAR(45)
  user_agent : TEXT
  created_at : TIMESTAMPTZ
}

entity "api_subscription_status" as api_subscription_status {
  *id : UUID <<PK>>
  --
  *shopify_gid : VARCHAR(255) <<UNIQUE>>
  *app_id : UUID
  *myshopify_domain : VARCHAR(255)
  shop_name : VARCHAR(255)
  plan_name : VARCHAR(255)
  *risk_state : VARCHAR(30) <<CHECK: SAFE, ONE_CYCLE_MISSED, TWO_CYCLES_MISSED, CHURNED>>
  *is_paid_current_cycle : BOOLEAN
  months_overdue : INT <<DEFAULT: 0>>
  last_successful_charge_date : TIMESTAMPTZ
  expected_next_charge_date : TIMESTAMPTZ
  *status : VARCHAR(20) <<CHECK: ACTIVE, CANCELLED, FROZEN, PENDING>>
  last_synced_at : TIMESTAMPTZ
}

entity "api_usage_status" as api_usage_status {
  *id : UUID <<PK>>
  --
  *shopify_gid : VARCHAR(255) <<UNIQUE>>
  *subscription_shopify_gid : VARCHAR(255)
  *subscription_id : UUID
  billed : BOOLEAN <<DEFAULT: FALSE>>
  billing_date : TIMESTAMPTZ
  *amount_cents : INT
  description : TEXT
  last_synced_at : TIMESTAMPTZ
}

entity "sync_jobs" as sync_jobs {
  *id : UUID <<PK>>
  --
  *app_id : UUID <<FK>>
  *user_id : UUID <<FK>>
  *partner_account_id : UUID <<FK>>
  parent_job_id : UUID <<FK, self-ref>>
  *job_type : VARCHAR(50) <<CHECK: full_sync, transaction_sync, snapshot_sync, event_sync, status_sync, store_sync, review_sync>>
  *status : VARCHAR(30) <<CHECK: pending, processing, completed, failed, cancelled, partial_failure>>
  priority : INT <<DEFAULT: 5>>
  total_items : INT
  completed_items : INT
  entity_type : VARCHAR(50)
  error_message : TEXT
  worker_id : VARCHAR(100)
  started_at : TIMESTAMPTZ
  completed_at : TIMESTAMPTZ
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "app_events" as app_events {
  *id : UUID <<PK>>
  --
  *app_id : UUID <<FK>>
  *shopify_event_gid : VARCHAR(255) <<UNIQUE>>
  *event_type : VARCHAR(100)
  shop_gid : VARCHAR(255)
  shop_domain : VARCHAR(255)
  *occurred_at : TIMESTAMPTZ
  created_at : TIMESTAMPTZ
}

entity "shops" as shops {
  *id : UUID <<PK>>
  --
  *myshopify_domain : VARCHAR(255) <<UNIQUE>>
  shopify_shop_gid : VARCHAR(255)
  shop_name : VARCHAR(255)
  logo_url : TEXT
  square_logo_url : TEXT
  cover_image_url : TEXT
  primary_domain : VARCHAR(255)
  country_code : VARCHAR(10)
  currency_code : VARCHAR(3)
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "app_reviews" as app_reviews {
  *id : UUID <<PK>>
  --
  *app_id : UUID <<FK>>
  *source_review_id : VARCHAR(255) <<UNIQUE>>
  author : VARCHAR(255)
  *rating : INT
  body : TEXT
  *review_date : TIMESTAMPTZ
  location : VARCHAR(255)
  time_using : VARCHAR(100)
  source : VARCHAR(50) <<DEFAULT: shopify_app_store>>
  scraped_at : TIMESTAMPTZ
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "billing_subscriptions" as billing_subscriptions {
  *id : UUID <<PK>>
  --
  *user_id : UUID <<FK>>
  *razorpay_subscription_id : VARCHAR(100) <<UNIQUE>>
  razorpay_plan_id : VARCHAR(100)
  razorpay_customer_id : VARCHAR(100)
  *plan : VARCHAR(20) <<CHECK: STARTER, PRO>>
  *status : VARCHAR(20) <<CHECK: CREATED, ACTIVE, PENDING, HALTED, CANCELLED, COMPLETED>>
  amount_cents : BIGINT
  currency : VARCHAR(3) <<DEFAULT: INR>>
  current_period_start : TIMESTAMPTZ
  current_period_end : TIMESTAMPTZ
  short_url : TEXT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

' Organization Relationships
organizations ||--o{ org_members : "has"
organizations ||--o{ org_invitations : "tracks"
organizations ||--o{ org_audit_log : "records"
organizations ||--o{ partner_accounts : "owns"
organizations ||--o{ api_keys : "scopes"
org_members }o--|| users : "user"
org_invitations }o--|| users : "invited_by"
org_audit_log }o--|| users : "actor"
users ||--o{ organizations : "created_by"

' Core Relationships
users ||--o{ partner_accounts : "has"
users ||--o{ device_tokens : "registers"
users ||--o| notification_preferences : "configures"
users ||--o| user_preferences : "customizes"
users ||--o{ api_keys : "manages"
partner_accounts ||--o{ apps : "tracks"
apps ||--o{ transactions : "records"
apps ||--o{ subscriptions : "has"
apps ||--o{ daily_metrics_snapshot : "snapshots"
apps ||--o{ daily_insight : "insights"
subscriptions ||--o{ subscription_events : "logs"
api_keys ||--o{ api_audit_log : "audits"
user_preferences }o--o| apps : "default_app"
apps ||--o{ sync_jobs : "tracks"
sync_jobs ||--o{ sync_jobs : "parent_job_id"
users ||--o{ sync_jobs : "triggers"
apps ||--o{ app_events : "records"
apps ||--o{ app_reviews : "has"
users ||--o| billing_subscriptions : "subscribes"

' CQRS Read Model (denormalized, populated from subscriptions/transactions)
apps ..> api_subscription_status : "populates"
apps ..> api_usage_status : "populates"

note right of users
  Migration: 000001_create_users_table
  Migration: 000025_add_onboarding_completed_at
  - Firebase authentication
  - Role-based access control
  - Onboarding status tracking
end note

note right of partner_accounts
  Migration: 000002_create_partner_accounts_table
  Migration: 000037_backfill_organizations (org_id)
  - Shopify Partner OAuth
  - AES-256-GCM encrypted tokens
  - org_id is the PRIMARY scoping FK
    (all data queries resolve via
     OrgContextMW → FindByOrgID)
  - user_id retained for fallback /
    background jobs only

  Indexes:
  - idx_partner_accounts_user_id
  - idx_partner_accounts_partner_id
  - idx_partner_accounts_org_id
end note

note right of apps
  Migration: 000003_create_apps_table
  Migration: 000017_add_revenue_share_tier
  Migration: 000027_add_install_count
  Migration: 000041_add_app_store_slug
  - Shopify apps being tracked
  - One app selected per user
  - Revenue share tier (0%, 15%, 20%)
  - Install count from Partner API events
  - app_store_slug for review scraping

  Indexes:
  - idx_apps_partner_account_id
  - idx_apps_tracking_enabled
  - idx_apps_install_count
end note

note right of transactions
  Migrations: 000004, 000011, 000017, 000018, 000020
  - Immutable ledger of transactions
  - Upsert by shopify_gid (idempotent)
  - shop_name: Store display name
  - gross_amount: Subscription price (pre-Shopify cut)
  - Fee breakdown: shopify_fee, processing_fee, tax
  - Earnings tracking: PENDING → AVAILABLE → PAID_OUT
  - Subscription reference for AppSubscriptionSale

  Indexes:
  - idx_transactions_app_date
  - idx_transactions_domain
  - idx_transactions_type
  - idx_transactions_earnings
  - idx_transactions_subscription_gid
  - idx_transactions_subscription_status
end note

note right of subscriptions
  Migrations: 000005, 000010, 000016, 000021, 000022, 000035
  - Rebuilt from transactions (deterministic)
  - Tracks last_recurring_charge_date
  - Computes expected_next_charge_date
  - Risk classification
  - Soft delete support (deleted_at)
  - Shop GID for webhook/event lookup
  - stable_domain_key: lg_sub_ + SHA1(domain) for churn-return tracking

  Indexes:
  - idx_subscriptions_app_status
  - idx_subscriptions_app_risk
  - idx_subscriptions_domain
  - idx_subscriptions_expected_charge
  - idx_subscriptions_shop_gid
end note

note right of subscription_events
  Migration: 000023_create_subscription_events_table
  - Lifecycle event audit trail
  - Tracks status and risk state transitions
  - Supports churn analysis (voluntary vs involuntary)
  - Event types: webhook, sync, billing_failure, app_uninstalled

  Indexes:
  - idx_subscription_events_subscription_id
  - idx_subscription_events_type_occurred
  - idx_subscription_events_churn (partial)
end note

note right of daily_metrics_snapshot
  Migration: 000006_create_daily_metrics_snapshot_table
  - Immutable daily KPI snapshots
  - One per app per day (never deleted)
  - Computed by MetricsEngine

  Metrics:
  - Active MRR (SAFE only)
  - Revenue at Risk (ONE_CYCLE + TWO_CYCLES)
  - Usage Revenue / Total Revenue
  - Renewal Success Rate

  Indexes:
  - idx_daily_metrics_app_date
  - idx_daily_metrics_app_latest
end note

note right of daily_insight
  Migration: 000007_create_daily_insight_table
  - AI-generated executive briefs (80-120 words)
  - Pro tier only (gated by plan_tier)
  - Generated from DailyMetricsSnapshot

  Indexes:
  - idx_daily_insight_app_date
end note

note right of notification_preferences
  Migration: 000009_create_notification_preferences_table
  Migration: 000039_extend_notification_preferences
  - Per-user notification configuration
  - Channel toggles: email, Slack
  - Alert category toggles: churn, revenue, review
  - Risk threshold for alert triggering
  - Slack webhook integration

  Indexes:
  - idx_notification_preferences_user_id
end note

note right of user_preferences
  Migration: 000019_create_user_preferences_table
  Migration: 000026_add_default_app
  Migration: 000038_add_selected_org
  Migration: 000040_add_sync_workspace_to_preferences
  - Dashboard KPI configuration
  - Widget visibility preferences
  - Per-user customization
  - Default app selection for multi-app users
  - selected_org_id: persists org choice
    across logins and devices
  - Sync settings: auto_sync, sync_frequency
  - Display prefs: workspace_name, currency, timezone

  Indexes:
  - idx_user_preferences_user_id
end note

note right of api_keys
  Migration: 000012_create_api_keys_table
  - Revenue API access keys
  - SHA-256 hashed (raw key never stored)
  - Rate limiting per key
  - Owner role only
  - Active status: revoked_at IS NULL

  Indexes:
  - idx_api_keys_user_id
  - idx_api_keys_key_hash
  - idx_api_keys_active (partial)
end note

note right of api_audit_log
  Migration: 000015_create_api_audit_log_table
  - Revenue API request logging
  - Debugging and compliance
  - Error tracking

  Indexes:
  - idx_api_audit_key_created
  - idx_api_audit_created
  - idx_api_audit_errors (partial)
end note

note bottom of api_subscription_status
  Migration: 000013 (CQRS Read Model)
  - Populated from subscriptions after sync
  - Optimized for Revenue API queries
  - Denormalized for fast lookups
end note

note bottom of api_usage_status
  Migration: 000014 (CQRS Read Model)
  - Populated from usage transactions
  - Tracks billed/unbilled usage
  - Links to parent subscription
end note

note right of organizations
  Migration: 000036_create_organizations_tables
  - Top-level data-owning entity
  - Plan tier determines app limits:
    FREE/STARTER=1, PRO=unlimited (MaxApps)
  - Org-level webhooks (STARTER+)
  - SSO/SAML support (PRO only)
  - partner_accounts.org_id replaces
    user-level data ownership
end note

note right of org_members
  Migration: 000036
  - Links users to organizations
  - Role: OWNER > ADMIN > VIEWER
  - Status: ACTIVE, SUSPENDED
  - Per-member notification preferences
  - Suspended members get 403

  Indexes:
  - idx_org_members_user
  - idx_org_members_org
  - idx_org_members_status
end note

note right of org_invitations
  Migration: 000036
  - Email-based invitations with token
  - Pending invitations count toward limit
  - 7-day expiry

  Indexes:
  - idx_org_invitations_token
end note

note right of org_audit_log
  Migration: 000036
  - Immutable audit trail for org actions
  - Actions: member.invited, member.removed,
    member.suspended, role.changed, etc.
  - Metadata JSONB for extra context

  Indexes:
  - idx_audit_log_org (org_id, created_at DESC)
  - idx_audit_log_actor (actor_id, created_at DESC)
end note

note right of billing_subscriptions
  Migration: 000028_create_billing_subscriptions
  - Razorpay B2B subscription billing
  - Maps to LedgerGuard plan tiers (STARTER, PRO)
  - Status lifecycle: CREATED → ACTIVE → CANCELLED/COMPLETED
  - Webhook updates from Razorpay

  Indexes:
  - idx_billing_subs_user_id
  - idx_billing_subs_razorpay_id
end note

note right of shops
  Migration: 000020_create_shops_table
  - Shopify shop metadata (enriched from Partner API)
  - shopify_shop_gid: Shopify global ID
  - Logos, cover image, primary domain
  - Country/currency codes for localization

  Indexes:
  - idx_shops_myshopify_domain
end note

@enduml
