' ==========================================
' 22. Org-Scoped Data Query Flow
' ==========================================
newpage Org-Scoped Data Query Flow

actor User
participant "Client App" as App
participant "AuthMW" as AuthMW
participant "OrgContextMW" as OrgMW
participant "Handler\n(any data endpoint)" as Handler
participant "resolvePartnerAccount" as Resolve
database "PostgreSQL" as DB

note over User, DB
  All data endpoints (apps, sync, metrics,
  integrations) resolve partner accounts via
  org context instead of user ID.
  OrgContextMW auto-selects for single-org users.
end note

== Single-Org User (Auto-Select) ==

User -> App: GET /api/v1/apps
App -> AuthMW: Authorization: Bearer <token>
AuthMW -> AuthMW: Verify Firebase token
AuthMW -> DB: Find/create user
DB --> AuthMW: User (set in context)

AuthMW -> OrgMW: Continue
OrgMW -> DB: SELECT org_id, role, status\nFROM org_members\nWHERE user_id = ?
DB --> OrgMW: [{org_id: A, role: OWNER, status: ACTIVE}]

alt Exactly 1 org
    OrgMW -> DB: SELECT * FROM organizations\nWHERE id = A
    DB --> OrgMW: Organization A
    OrgMW -> OrgMW: Set org in request context
    OrgMW -> Handler: Continue (org in ctx)
else 0 orgs
    OrgMW -> Handler: Continue (no org in ctx)
end

Handler -> Resolve: resolvePartnerAccount(r, partnerRepo)

Resolve -> Resolve: org := OrgFromContext(ctx)
alt org != nil
    Resolve -> DB: SELECT * FROM partner_accounts\nWHERE org_id = ?
    DB --> Resolve: PartnerAccount
else org == nil (fallback)
    Resolve -> DB: SELECT * FROM partner_accounts\nWHERE user_id = ?
    DB --> Resolve: PartnerAccount
end

Resolve --> Handler: PartnerAccount

Handler -> DB: SELECT * FROM apps\nWHERE partner_account_id = ?
DB --> Handler: App list
Handler --> App: 200 OK { apps: [...] }

== Multi-Org User (X-Org-Id Header) ==

User -> App: GET /api/v1/apps\nX-Org-Id: <orgB-uuid>
App -> AuthMW: Bearer token + X-Org-Id
AuthMW -> OrgMW: Continue

OrgMW -> OrgMW: Read X-Org-Id header
OrgMW -> DB: SELECT role, status FROM org_members\nWHERE org_id = ? AND user_id = ?
DB --> OrgMW: {role: ADMIN, status: ACTIVE}

alt Active member
    OrgMW -> DB: SELECT * FROM organizations\nWHERE id = ?
    DB --> OrgMW: Organization B
    OrgMW -> Handler: Continue (org B in ctx)
else Suspended
    OrgMW --> App: 403 "account suspended"
else Not a member
    OrgMW --> App: 403 "not a member"
end

Handler -> Resolve: resolvePartnerAccount(r, partnerRepo)
Resolve -> DB: FindByOrgID(orgB)
DB --> Resolve: PartnerAccount (for org B)
Resolve --> Handler: PartnerAccount
Handler --> App: 200 OK (org B's data)

== Multi-Org Without Header ==

User -> App: GET /api/v1/apps\n(no X-Org-Id)
App -> AuthMW: Bearer token only
AuthMW -> OrgMW: Continue

OrgMW -> DB: SELECT * FROM org_members\nWHERE user_id = ?
DB --> OrgMW: [{org A}, {org B}]

alt Multiple orgs, no header
    OrgMW --> App: 400 "org selection required\n(X-Org-Id header missing)"
end

' ==========================================
' 23. UUID-Based App Resolution (resolveAppFromRequest)
' ==========================================
newpage UUID App Resolution (resolveAppFromRequest)

participant "Frontend" as FE
participant "Handler" as AppHandler
participant "app_lookup.go" as AppLookup
participant "AppRepository" as AppDB

note over FE, AppDB
  Since ADR-036 (2026-05-08), all app-scoped endpoints
  require UUID app IDs in URL path. Numeric Shopify IDs
  are rejected with 400. Used by 13+ handlers.
end note

== UUID App Resolution (Happy Path) ==

FE -> AppHandler: GET /api/v1/apps/{uuid}/subscriptions

AppHandler -> AppLookup: resolveAppFromRequest(r, partnerRepo, appRepo)
AppLookup -> AppLookup: appIDStr := chi.URLParam(r, "appID")
AppLookup -> AppLookup: uuid.Parse(appIDStr)
alt Valid UUID
    AppLookup -> AppDB: FindByID(ctx, appID)
    AppDB --> AppLookup: *entity.App
    AppLookup --> AppHandler: app, nil
    AppHandler -> AppHandler: Use app.ID for queries
else Invalid UUID format
    AppLookup --> AppHandler: nil, 400 "invalid app ID format"
    AppHandler --> FE: 400 Bad Request
else App not found
    AppDB --> AppLookup: nil / error
    AppLookup --> AppHandler: nil, 404 "app not found"
    AppHandler --> FE: 404 Not Found
end

== Frontend ID Resolution ==

note over FE
  ShopifyApp model:
  - id: UUID (from json['uuid'])
  - shopifyId: numeric (from json['id'], display only)
  All API calls use app.id (UUID).
end note

FE -> AppHandler: GET /api/v1/apps\n(list apps for partner account)
AppHandler --> FE: 200 [{ "uuid": "abc-123", "id": "5001", ... }]

note over FE
  app.id = "abc-123" (UUID)
  app.shopifyId = "5001" (display)
  All subsequent API calls: /apps/abc-123/...
end note

' ==========================================
' 24. Daily Catch-Up Sync Flow
' ==========================================
newpage Daily Catch-Up Sync Flow

participant "Cloud Scheduler\n(or Admin)" as Trigger
participant "API Server" as API
participant "DailyCatchupScheduler" as DCS
participant "QueueSyncService" as QSvc
participant "Redis" as Redis
database "PostgreSQL" as DB

note over Trigger, DB
  Enqueues transaction_sync + event_sync
  for every active app with a 2-day lookback.
  Runs at 3 AM UTC daily, or triggered manually.
end note

== Scheduled Trigger (3 AM UTC) ==

DCS -> DCS: Timer fires (3 AM UTC)
DCS -> DCS: RunOnce(ctx, lookbackDays=2)

DCS -> DB: SELECT DISTINCT pa.id, pa.user_id\nFROM partner_accounts pa\nJOIN apps a ON a.partner_account_id = pa.id\nWHERE a.tracking_enabled = true
DB --> DCS: Active partner accounts

loop For each partner account
    DCS -> DB: SELECT id FROM apps\nWHERE partner_account_id = ?\nAND tracking_enabled = true
    DB --> DCS: App list

    loop For each app
        DCS -> QSvc: EnqueueCatchupSync(appID,\nuserID, partnerAccountID,\nlookbackDays=2)

        QSvc -> DB: INSERT sync_jobs\n(type=transaction_sync, status=pending)\nwith lookback_days=2
        QSvc -> Redis: LPUSH :queue:regular\n{payload with lookbackDays}
        QSvc --> DCS: job

        DCS -> QSvc: EnqueueCatchupSync(appID,\nuserID, partnerAccountID,\nlookbackDays=2, type=event_sync)

        QSvc -> DB: INSERT sync_jobs\n(type=event_sync, status=pending)
        QSvc -> Redis: LPUSH :queue:regular\n{payload}
        QSvc --> DCS: job
    end
end

DCS -> DCS: Log "daily catch-up complete:\nN apps, M jobs enqueued"

== Manual Trigger (Admin) ==

Trigger -> API: POST /api/v1/admin/sync/daily-catchup\n[Authorization: Bearer <token>]

API -> API: AuthMiddleware + AdminMiddleware
API -> DCS: RunOnce(ctx, lookbackDays=2)
note right: Same flow as scheduled

DCS --> API: nil
API --> Trigger: 200 OK\n{ "message": "daily catch-up triggered" }

== Internal Trigger (Cloud Scheduler) ==

Trigger -> API: POST /api/v1/internal/sync/daily-catchup

API -> DCS: RunOnce(ctx, lookbackDays=2)
DCS --> API: nil
API --> Trigger: 200 OK

note over DCS
  Worker processing:
  TransactionProcessor checks LookbackDays > 0
  → fetches from now-2d instead of 12-month window
  → faster sync, less API pressure
end note

@enduml
