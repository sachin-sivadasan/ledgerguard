    {"id": "lc-note", "type": "text", "x": 80, "y": 730, "width": 220, "height": 65, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 70, "groupIds": [], "frameId": null, "roundness": null, "seed": 2319, "version": 1, "versionNonce": 2319, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Suspended members:\n- Cannot access org data (403)\n- Still count toward member limit\n- Can be unsuspended by ADMIN+", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Suspended members:\n- Cannot access org data (403)\n- Still count toward member limit\n- Can be unsuspended by ADMIN+", "autoResize": true, "lineHeight": 1.25},


    {"id": "sec5-label", "type": "text", "x": 700, "y": 620, "width": 280, "height": 26, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2400, "version": 1, "versionNonce": 2400, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "5. Roles & Permissions", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "5. Roles & Permissions", "autoResize": true, "lineHeight": 1.25},

    {"id": "role-table", "type": "rectangle", "x": 700, "y": 655, "width": 340, "height": 155, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g-roles"], "frameId": null, "roundness": {"type": 3}, "seed": 2401, "version": 1, "versionNonce": 2401, "isDeleted": false, "boundElements": [{"type": "text", "id": "role-table-t"}], "updated": 1, "link": null, "locked": false},
    {"id": "role-table-t", "type": "text", "x": 710, "y": 660, "width": 320, "height": 145, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g-roles"], "frameId": null, "roundness": null, "seed": 2402, "version": 1, "versionNonce": 2402, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "OWNER  — Full control, billing, delete org\n         remove admins, manage SSO\nADMIN  — Manage members, apps, sync,\n         webhooks, API keys, audit log\n         (cannot remove other admins)\nVIEWER — Read-only dashboard access\n         (cannot sync, manage, invite)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "containerId": "role-table", "originalText": "OWNER  — Full control, billing, delete org\n         remove admins, manage SSO\nADMIN  — Manage members, apps, sync,\n         webhooks, API keys, audit log\n         (cannot remove other admins)\nVIEWER — Read-only dashboard access\n         (cannot sync, manage, invite)", "autoResize": true, "lineHeight": 1.25},


    {"id": "sec6-label", "type": "text", "x": 1100, "y": 620, "width": 280, "height": 26, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2500, "version": 1, "versionNonce": 2500, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "6. Multi-Org + X-Org-Id", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "6. Multi-Org + X-Org-Id", "autoResize": true, "lineHeight": 1.25},

    {"id": "mo-box", "type": "rectangle", "x": 1100, "y": 655, "width": 340, "height": 155, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g-multiorg"], "frameId": null, "roundness": {"type": 3}, "seed": 2501, "version": 1, "versionNonce": 2501, "isDeleted": false, "boundElements": [{"type": "text", "id": "mo-box-t"}], "updated": 1, "link": null, "locked": false},
    {"id": "mo-box-t", "type": "text", "x": 1110, "y": 660, "width": 320, "height": 145, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g-multiorg"], "frameId": null, "roundness": null, "seed": 2502, "version": 1, "versionNonce": 2502, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "A user can belong to multiple orgs\n(e.g., freelancer managing 2 companies)\n\n1 org  → auto-selected, no header needed\n2+ orgs → OrgSwitcher dropdown in nav\n          X-Org-Id header on all requests\n\nOrgContextMW resolves org from:\n  URL path {orgId} OR X-Org-Id header", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "containerId": "mo-box", "originalText": "A user can belong to multiple orgs\n(e.g., freelancer managing 2 companies)\n\n1 org  → auto-selected, no header needed\n2+ orgs → OrgSwitcher dropdown in nav\n          X-Org-Id header on all requests\n\nOrgContextMW resolves org from:\n  URL path {orgId} OR X-Org-Id header", "autoResize": true, "lineHeight": 1.25},


    {"id": "sec7-label", "type": "text", "x": 1100, "y": 830, "width": 340, "height": 26, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2600, "version": 1, "versionNonce": 2600, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "7. Org-Scoped Data Query", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "7. Org-Scoped Data Query", "autoResize": true, "lineHeight": 1.25},

    {"id": "osdq-box", "type": "rectangle", "x": 1100, "y": 865, "width": 340, "height": 165, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g-orgquery"], "frameId": null, "roundness": {"type": 3}, "seed": 2601, "version": 1, "versionNonce": 2601, "isDeleted": false, "boundElements": [{"type": "text", "id": "osdq-box-t"}], "updated": 1, "link": null, "locked": false},
    {"id": "osdq-box-t", "type": "text", "x": 1110, "y": 870, "width": 320, "height": 155, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["g-orgquery"], "frameId": null, "roundness": null, "seed": 2602, "version": 1, "versionNonce": 2602, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "All data endpoints resolve via org:\n\nAuthMW → OrgContextMW\n  → resolvePartnerAccount(r, repo)\n    → FindByOrgID(org.ID)  [preferred]\n    → FindByUserID(user.ID) [fallback]\n  → partner_accounts.org_id → apps\n\nRoutes: /apps/*, /sync/*, /metrics/*,\n        /integrations/shopify/status\n\nBackground jobs keep FindByUserID", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "containerId": "osdq-box", "originalText": "All data endpoints resolve via org:\n\nAuthMW → OrgContextMW\n  → resolvePartnerAccount(r, repo)\n    → FindByOrgID(org.ID)  [preferred]\n    → FindByUserID(user.ID) [fallback]\n  → partner_accounts.org_id → apps\n\nRoutes: /apps/*, /sync/*, /metrics/*,\n        /integrations/shopify/status\n\nBackground jobs keep FindByUserID", "autoResize": true, "lineHeight": 1.25}
  ],
