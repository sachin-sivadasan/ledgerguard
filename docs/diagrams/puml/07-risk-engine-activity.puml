@startuml
title 07. Risk Engine – Classification Logic

skinparam activityArrowThickness 2

start

partition "status_sync reconciliation\n(Subscription.ApplyEventStatus)" {
  :Input: event-derived status + deciding event time (eventAt) + now;
  if (status is terminal\n(CANCELLED / UNINSTALLED)?) then (yes)
    if (recurring charge post-dates the event\nAND is recent? (billedSince)) then (yes)
      #lightgreen:Stale / plan-change cancel —\nactive billing wins: status := ACTIVE;
    else (no)
      #salmon:Genuine churn: status := terminal\nRiskState := **CHURNED**;
      stop
    endif
  else (non-terminal)
  endif
  :Re-derive risk from charge recency below\n(ClassifyRisk) — never leave a stale ACTIVE/CHURNED mix;
}

:Input: Subscription + now (time);

if (Status is CANCELLED\nor EXPIRED?) then (yes)
  #salmon:Return **CHURNED**;
  stop
else (no)
endif

if (Status is FROZEN?) then (yes)
  #orange:Return **ONE_CYCLE_MISSED**;
  stop
else (no)
endif

if (Status is PENDING?) then (yes)
  #lightgreen:Return **SAFE**;
  stop
else (no)
endif

if (Status is ACTIVE and\nnow ≤ expectedNextCharge?) then (yes)
  #lightgreen:Return **SAFE**;
  stop
else (no)
endif

if (ExpectedNextChargeDate\nis null?) then (yes)
  #lightgreen:Return **SAFE**\n(cannot classify);
  stop
else (no)
endif

:Calculate daysPastDue =\n(now - expectedNextCharge) / 24h;

if (daysPastDue ≤ 0) then (yes)
  #lightgreen:Return **SAFE**;
  stop
elseif (daysPastDue ≤ 30) then (yes)
  #lightgreen:Return **SAFE**\n(grace period);
  stop
elseif (daysPastDue ≤ 60) then (yes)
  #orange:Return **ONE_CYCLE_MISSED**;
  stop
elseif (daysPastDue ≤ 90) then (yes)
  #OrangeRed:Return **TWO_CYCLES_MISSED**;
  stop
else (> 90)
  #salmon:Return **CHURNED**;
  stop
endif

@enduml
