@startuml
title 09. Daily Snapshot Upsert Flow

skinparam sequenceArrowThickness 2

participant "LedgerService" as Ledger
participant "MetricsEngine" as Metrics
participant "SnapshotRepository" as Repo
database "PostgreSQL" as DB

== During Sync (Current Day) ==

Ledger -> Metrics: ComputeAllMetrics(\n  appID, subs, txs, now)
activate Metrics

Metrics -> Metrics: CalculateActiveMRR()
Metrics -> Metrics: CalculateRevenueAtRisk()
Metrics -> Metrics: CalculateUsageRevenue()
Metrics -> Metrics: CalculateTotalRevenue()
Metrics -> Metrics: CalculateRenewalSuccessRate()
Metrics -> Metrics: Count by risk state

Metrics --> Ledger: DailyMetricsSnapshot
deactivate Metrics

Ledger -> Repo: Upsert(snapshot)
Repo -> DB: INSERT INTO daily_metrics_snapshots\n  (app_id, date, ...)\nON CONFLICT (app_id, date)\n  DO UPDATE SET ...
DB --> Repo: OK
Repo --> Ledger: OK

== Historical Backfill (Daily, Optimized O(n log n)) ==

Ledger -> Ledger: Sort transactions by date\n(once, O(n log n))
Ledger -> Ledger: Find date range\nfrom earliest tx to latest

loop For each day in range (pointer advancement)
  Ledger -> Ledger: Advance txPtr —\nappend txs up to current date\n(each tx visited exactly once)
  Ledger -> Ledger: Rebuild subscriptions\nfrom cumulative txs
  Ledger -> Ledger: Filter trailing 30-day\nwindow for revenue

  Ledger -> Metrics: ComputeAllMetrics(\n  appID, subs, windowTxs, date)
  Metrics --> Ledger: DailyMetricsSnapshot

  Ledger -> Ledger: Collect snapshot in memory
end

Ledger -> Repo: UpsertBatch(snapshots[])
Repo -> DB: Multi-row INSERT\n(batches of 50)\nON CONFLICT UPDATE
DB --> Repo: OK

@enduml
