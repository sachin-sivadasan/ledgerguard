@startuml
title 40. Flutter Provider → Service → API Dependency Graph

skinparam componentStyle rectangle
skinparam componentArrowThickness 2
skinparam packageBorderThickness 2
skinparam defaultFontSize 11
skinparam arrowColor #555555

' ──────────────────────────────────────────────
'  Providers
' ──────────────────────────────────────────────
package "Providers" #LightBlue {
  [AuthProvider] as AuthP
  [AppsProvider] as AppsP
  [DashboardProvider] as DashP
  [SubscriptionProvider] as SubP
  [StoreProvider] as StoreP
  [TransactionProvider] as TxP
  [EventsProvider] as EventsP
  [RiskProvider] as RiskP
  [AnalyticsProvider] as AnalyticsP
  [EarningsProvider] as EarningsP
  [InsightsProvider] as InsightsP
  [SyncStatusProvider] as SyncP
  [SettingsProvider] as SettingsP
  [OrganizationProvider] as OrgP
  [ApiKeyProvider] as ApiKeyP
  [WebhookProvider] as WebhookP
}

' ──────────────────────────────────────────────
'  Report Providers (Reports section)
'  Each has a fetch<Rows>Page() method for the
'  paged "View all" detail screens.
' ──────────────────────────────────────────────
package "Report Providers" #LightSkyBlue {
  [EarningsReportProvider] as EarnRepP
  [MrrReportProvider] as MrrP
  [RevenueMixProvider] as RevMixP
  [UsageProvider] as UsageP
  [UsageTrendsProvider] as UsageTrP
  [SubscriptionsProvider] as SubsP
  [PayoutScheduleProvider] as PaySchP
  [PayoutHistoryProvider] as PayHistP
  [InstallsProvider] as InstallsP
  [NetNewSubsProvider] as NnsP
  [RevenueAtRiskProvider] as RarP
  [ChurnProvider] as ChurnP
  [RetentionProvider] as RetP
  [CohortsProvider] as CohortsP
  [ReviewsProvider] as ReviewsP
  [UninstallContextProvider] as UninstallP
}

' ──────────────────────────────────────────────
'  Services
' ──────────────────────────────────────────────
package "Services" #LightGreen {
  [AppService] as AppSvc
  [EarningsService] as EarnSvc
  [EventsService] as EventsSvc
  [InsightsService] as InsightsSvc
  [MetricsService] as MetricsSvc
  [MixpanelService] as MixSvc
  [OrganizationService] as OrgSvc
  [RiskService] as RiskSvc
  [StoreService] as StoreSvc
  [SubscriptionService] as SubSvc
  [SyncStatusService] as SyncSvc
  [TransactionService] as TxSvc
  [UserPreferencesService] as PrefsSvc
}

' ──────────────────────────────────────────────
'  Report Services (one per report provider)
' ──────────────────────────────────────────────
package "Report Services" #PaleGreen {
  [EarningsReportService] as EarnRepSvc
  [MrrReportService] as MrrSvc
  [RevenueMixService] as RevMixSvc
  [UsageService] as UsageSvc
  [UsageTrendsService] as UsageTrSvc
  [SubscriptionsService] as SubsSvc
  [PayoutScheduleService] as PaySchSvc
  [PayoutHistoryService] as PayHistSvc
  [InstallsService] as InstallsSvc
  [NetNewSubsService] as NnsSvc
  [RevenueAtRiskService] as RarSvc
  [ChurnService] as ChurnSvc
  [RetentionService] as RetSvc
  [CohortsService] as CohortsSvc
  [ReviewsService] as ReviewsSvc
  [UninstallContextService] as UninstallSvc
}

' ──────────────────────────────────────────────
'  Infrastructure
' ──────────────────────────────────────────────
package "Infrastructure" #LightCoral {
  [ApiClient] as API
  cloud "Backend REST API\n(Go)" as Backend
  [Firebase Auth] as FBAuth
  [AppConfig] as Config
}

' ──────────────────────────────────────────────
'  Cross-cutting: DemoModeCoordinator
' ──────────────────────────────────────────────
package "Cross-cutting" #Wheat {
  [DemoModeCoordinator] as Demo
}

' ══════════════════════════════════════════════
'  Provider → Service dependencies
' ══════════════════════════════════════════════

' AuthProvider — uses Firebase Auth directly
AuthP --> FBAuth

' AppsProvider
AppsP --> AppSvc
AppsP --> PrefsSvc

' DashboardProvider
DashP --> MetricsSvc
DashP --> PrefsSvc

' SubscriptionProvider
SubP --> SubSvc

' StoreProvider
StoreP --> StoreSvc
StoreP --> SubSvc

' TransactionProvider
TxP --> TxSvc

' EventsProvider
EventsP --> EventsSvc

' RiskProvider
RiskP --> RiskSvc

' AnalyticsProvider
AnalyticsP --> MetricsSvc
AnalyticsP --> EarnSvc

' EarningsProvider
EarningsP --> EarnSvc

' InsightsProvider
InsightsP --> InsightsSvc

' SyncStatusProvider
SyncP --> SyncSvc

' SettingsProvider
SettingsP --> PrefsSvc

' OrganizationProvider
OrgP --> OrgSvc
OrgP --> API
OrgP --> PrefsSvc

' ApiKeyProvider — calls API directly (no dedicated service)
ApiKeyP --> API

' WebhookProvider — calls API directly (no dedicated service)
WebhookP --> API

' ══════════════════════════════════════════════
'  Report Provider → Report Service
'  (each report provider injects exactly one service;
'   provider.fetch<Rows>Page() → service → ApiClient)
' ══════════════════════════════════════════════
EarnRepP  --> EarnRepSvc
MrrP      --> MrrSvc
RevMixP   --> RevMixSvc
UsageP    --> UsageSvc
UsageTrP  --> UsageTrSvc
SubsP     --> SubsSvc
PaySchP   --> PaySchSvc
PayHistP  --> PayHistSvc
InstallsP --> InstallsSvc
NnsP      --> NnsSvc
RarP      --> RarSvc
ChurnP    --> ChurnSvc
RetP      --> RetSvc
CohortsP  --> CohortsSvc
ReviewsP  --> ReviewsSvc
UninstallP --> UninstallSvc

' ══════════════════════════════════════════════
'  Service → ApiClient
' ══════════════════════════════════════════════
AppSvc --> API
EarnSvc --> API
EventsSvc --> API
InsightsSvc --> API
MetricsSvc --> API
OrgSvc --> API
RiskSvc --> API
StoreSvc --> API
SubSvc --> API
SyncSvc --> API
TxSvc --> API
PrefsSvc --> API

' Report services → ApiClient
EarnRepSvc  --> API
MrrSvc      --> API
RevMixSvc   --> API
UsageSvc    --> API
UsageTrSvc  --> API
SubsSvc     --> API
PaySchSvc   --> API
PayHistSvc  --> API
InstallsSvc --> API
NnsSvc      --> API
RarSvc      --> API
ChurnSvc    --> API
RetSvc      --> API
CohortsSvc  --> API
ReviewsSvc  --> API
UninstallSvc --> API

note top of EarnRepSvc
  **Report services (16)**
  Each wraps ApiClient and exposes the report
  summary fetch plus a paged rows fetch backing
  the provider's fetch<Rows>Page() (e.g.
  fetchChargesPage, fetchStoresPage,
  fetchPayoutsPage, fetchEventsPage,
  fetchSubscriptionsPage) for "View all" pages.
end note

' MixpanelService does NOT use ApiClient
note right of MixSvc
  Does **not** use ApiClient.
  Sends events to Mixpanel SDK.
end note

' ══════════════════════════════════════════════
'  ApiClient → Backend
' ══════════════════════════════════════════════
API --> Backend : HTTPS
Config --> API : base URL

' ══════════════════════════════════════════════
'  DemoModeCoordinator wraps providers
' ══════════════════════════════════════════════
Demo ..> AppsP : wraps
Demo ..> DashP
Demo ..> SubP
Demo ..> StoreP
Demo ..> TxP
Demo ..> EventsP
Demo ..> RiskP
Demo ..> AnalyticsP
Demo ..> EarningsP
Demo ..> InsightsP
Demo ..> WebhookP

' DemoModeCoordinator also wraps all 16 report providers
Demo ..> EarnRepP
Demo ..> MrrP
Demo ..> RevMixP
Demo ..> UsageP
Demo ..> UsageTrP
Demo ..> SubsP
Demo ..> PaySchP
Demo ..> PayHistP
Demo ..> InstallsP
Demo ..> NnsP
Demo ..> RarP
Demo ..> ChurnP
Demo ..> RetP
Demo ..> CohortsP
Demo ..> ReviewsP
Demo ..> UninstallP

note bottom of Demo
  Injects mock data into
  wrapped providers when
  demo mode is active.
end note

note bottom of Backend
  **Backend REST API (Go)**
  Base URL from AppConfig
  /api/v1/*
end note

@enduml
