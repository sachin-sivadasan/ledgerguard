@startuml LedgerGuard Flutter Screen Flow
!theme plain
title LedgerGuard — Flutter (Provider) Screen Flow
caption Based on GoRouter in frontend-flutter/lib/app.dart

skinparam StateFontSize 12
skinparam StateFontStyle bold
skinparam StateBackgroundColor #F8F9FA
skinparam StateBorderColor #343A40
skinparam ArrowColor #495057
skinparam NoteBackgroundColor #FFF3CD
skinparam NoteBorderColor #FFC107

' ─── Entry ────────────────────────────────────────────────────
[*] --> AuthGuard

' ─── Auth Guard ───────────────────────────────────────────────
state AuthGuard <<choice>>
note right of AuthGuard
  GoRouter redirect:
  - Not authenticated + non-auth route -> /login
  - Authenticated + auth route -> /
end note

AuthGuard --> AuthScreens : not authenticated
AuthGuard --> AppShell : authenticated

' ─── Auth Screens (no shell) ──────────────────────────────────
state "Auth Screens" as AuthScreens {
  state "/login\nLoginScreen" as Login
  state "/sign-up\nSignUpScreen" as SignUp
  state "/forgot-password\nForgotPasswordScreen" as ForgotPw

  Login --> SignUp : Create account
  SignUp --> Login : Back to login
  Login --> ForgotPw : Forgot password?
  ForgotPw --> Login : Back to login
}

AuthScreens --> AuthGuard : Login success\n(refreshListenable)

' ─── App Shell (StatefulShellRoute.indexedStack) ──────────────
state "AppShell\n(bottom bar / nav rail)" as AppShell {

  ' ── Primary Navigation ──────────────────────────────────────
  state "Primary Navigation" as PrimaryNav {
    state "/\nDashboardScreen" as Dashboard
    state "/subscriptions\nSubscriptionListScreen" as SubList
    state "/stores\nStoreListScreen" as StoreList
    state "/transactions\nTransactionsScreen" as Transactions
    state "/events\nEventsScreen" as Events

    ' Sub-routes
    state "/subscriptions/:id\nSubscriptionDetailScreen" as SubDetail
    state "/stores/:id\nStoreDetailScreen" as StoreDetail

    SubList --> SubDetail : Select subscription
    SubDetail --> SubList : Back
    StoreList --> StoreDetail : Select store
    StoreDetail --> StoreList : Back
  }

  ' ── Secondary Navigation ────────────────────────────────────
  state "Secondary Navigation" as SecondaryNav {
    state "/webhooks\nWebhooksScreen" as Webhooks
    state "/risk\nRiskScreen" as Risk
    state "/analytics\nAnalyticsScreen" as Analytics
    state "/earnings\nEarningsScreen" as Earnings
    state "/apps\nAppsScreen" as Apps
    state "/api-keys\nApiKeysScreen" as ApiKeys
    state "/insights\nInsightsScreen" as Insights
    state "/settings\nSettingsScreen" as Settings

    note bottom of Analytics
      Tabs: Revenue, Profit,
      Cohort, Forecasting, Multi-App
    end note

    note bottom of Apps
      Tabs: Apps, Reviews
    end note

    ' Settings sub-routes
    state "/settings/dashboard\nDashboardSettingsScreen" as DashSettings
    state "/settings/connect-shopify\nConnectShopifyScreen" as ConnectShopify
    state "/settings/team\nTeamScreen" as Team
    state "/settings/audit-log\nAuditLogScreen" as AuditLog

    Settings --> DashSettings : Customize Dashboard
    Settings --> ConnectShopify : Connect Shopify
    Settings --> Team : Team management
    Settings --> AuditLog : Audit log
    DashSettings --> Settings : Back
    ConnectShopify --> Settings : Back
    Team --> Settings : Back
    AuditLog --> Settings : Back
  }

  ' ── Reports Navigation ──────────────────────────────────────
  ' /reports index -> each report screen -> its "View all" paginated detail.
  state "Reports Navigation" as ReportsNav {
    state "/reports\nReportsScreen (index)" as ReportsIndex

    ' Reports WITH a dedicated paginated "View all" detail screen
    state "/reports/revenue-at-risk\nRevenueAtRiskScreen" as RarReport
    state "/reports/revenue-at-risk/stores\nRevenueAtRiskStoresScreen" as RarDetail
    state "/reports/churn\nChurnScreen" as ChurnReport
    state "/reports/churn/stores\nChurnStoresScreen" as ChurnDetail
    state "/reports/usage\nUsageScreen" as UsageReport
    state "/reports/usage/stores\nUsageStoresScreen" as UsageDetail
    state "/reports/payout-schedule\nPayoutScheduleScreen" as PayoutSchedReport
    state "/reports/payout-schedule/payouts\nPayoutSchedulePayoutsScreen" as PayoutSchedDetail
    state "/reports/payout-history\nPayoutHistoryScreen" as PayoutHistReport
    state "/reports/payout-history/payouts\nPayoutHistoryPayoutsScreen" as PayoutHistDetail
    state "/reports/installs\nInstallsScreen" as InstallsReport
    state "/reports/installs/events\nInstallsEventsScreen" as InstallsDetail
    state "/reports/net-new-subscriptions\nNetNewSubsScreen" as NnsReport
    state "/reports/net-new-subscriptions/subscriptions\nNetNewSubsSubscriptionsScreen" as NnsDetail
    state "/reports/earnings\nEarningsReportScreen" as EarningsReport
    state "/reports/earnings/charges\nEarningsChargesScreen" as EarningsDetail

    ' Reports WITHOUT a dedicated detail screen
    state "/reports/retention\nRetentionScreen" as RetentionReport
    state "/reports/usage-trends\nUsageTrendsScreen" as UsageTrendsReport
    state "/reports/subscriptions\nSubscriptionsScreen" as SubsReport
    state "/reports/cohorts\nCohortsReportScreen" as CohortsReport
    state "/reports/reviews\nReviewsReportScreen" as ReviewsReport
    state "/reports/uninstall-context\nUninstallContextScreen" as UninstallReport
    state "/reports/mrr\nMrrReportScreen" as MrrReport
    state "/reports/revenue-mix\nRevenueMixScreen" as RevMixReport

    ' Index -> reports (open a report card)
    ReportsIndex --> RarReport : Open report
    ReportsIndex --> ChurnReport : Open report
    ReportsIndex --> UsageReport : Open report
    ReportsIndex --> PayoutSchedReport : Open report
    ReportsIndex --> PayoutHistReport : Open report
    ReportsIndex --> InstallsReport : Open report
    ReportsIndex --> NnsReport : Open report
    ReportsIndex --> EarningsReport : Open report
    ReportsIndex --> RetentionReport : Open report
    ReportsIndex --> UsageTrendsReport : Open report
    ReportsIndex --> SubsReport : Open report
    ReportsIndex --> CohortsReport : Open report
    ReportsIndex --> ReviewsReport : Open report
    ReportsIndex --> UninstallReport : Open report
    ReportsIndex --> MrrReport : Open report
    ReportsIndex --> RevMixReport : Open report

    ' Report preview -> paginated detail (drill-down "View all")
    RarReport --> RarDetail : View all
    ChurnReport --> ChurnDetail : View all
    UsageReport --> UsageDetail : View all
    PayoutSchedReport --> PayoutSchedDetail : View all
    PayoutHistReport --> PayoutHistDetail : View all
    InstallsReport --> InstallsDetail : View all
    NnsReport --> NnsDetail : View all
    EarningsReport --> EarningsDetail : View all

    note bottom of ReportsIndex
      /reports appended LAST as its own
      StatefulShellBranch so existing
      branch indices don't shift.
      "View all" drills preview -> paginated detail.
    end note
  }

  ' ── Navigation between sections ─────────────────────────────
  PrimaryNav -[hidden]-> SecondaryNav
  SecondaryNav -[hidden]-> ReportsNav
}

' ─── Logout ───────────────────────────────────────────────────
AppShell --> AuthGuard : Logout\n(AuthProvider.signOut)

' ─── Legend ───────────────────────────────────────────────────
legend bottom left
  |= Symbol |= Meaning |
  | Primary Navigation | Bottom bar (mobile) / Nav rail top (desktop) |
  | Secondary Navigation | "More" menu (mobile) / Nav rail bottom (desktop) |
  | AuthGuard | GoRouter redirect — refreshListenable: AuthProvider |
  | StatefulShellRoute | indexedStack preserves tab state |
end legend

@enduml
